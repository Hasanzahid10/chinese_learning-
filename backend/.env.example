# ============================================================
# DATABASE CONFIGURATION (PostgreSQL for Production/VPS)
# ============================================================
USE_SQLITE=False
DB_NAME=chinese_learning_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432
# Alternatively you can provide a full connection string:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/chinese_learning_db

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
DJANGO_JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-on-vps
AI_INTERNAL_KEY=ai-internal-secret-key
AI_SERVICE_URL=http://127.0.0.1:8001

# ============================================================
# AI LLM PROVIDERS
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
